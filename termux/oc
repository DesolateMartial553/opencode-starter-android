#!/usr/bin/env bash
# oc: start / resume OpenCode inside tmux. Runs in Termux; OpenCode itself runs in the Debian proot.
# Usage: oc [new NAME | ls | kill [NAME] | shell | update | key ... | mirror | autostart on|off | doctor | help]
set -u
# `oc` is a Termux command. Inside the Debian shell (prompt "root@localhost") it cannot work, so say so.
if [ -f /etc/debian_version ]; then
  echo "You are inside the Debian shell (the prompt says root@localhost)."
  echo "Type  exit  to get back to Termux (the prompt ends in \$), then run oc again."
  exit 1
fi
DISTRO=debian
SESSION=opencode
REPO=DesolateMartial553/opencode-starter-android   # used by the "run the installer" hints
PD="${PREFIX:-/data/data/com.termux/files/usr}/var/lib/proot-distro"
# proot-distro 5+ keeps Debian in containers/NAME/rootfs; older versions used installed-rootfs/NAME
if [ -d "$PD/containers/$DISTRO/rootfs" ]; then ROOTFS="$PD/containers/$DISTRO/rootfs"; else ROOTFS="$PD/installed-rootfs/$DISTRO"; fi
KEYFILE="$ROOTFS/root/.config/opencode-keys.env"   # exported into OpenCode by /root/.oc-start.sh
CONF="$ROOTFS/root/.config/opencode/opencode.json"

bind_args() {
  # make the phone's shared storage visible inside Debian as ~/shared (reports land in ~/shared/Research)
  if [ -d "$HOME/storage/shared" ]; then printf '%s' "--bind $HOME/storage/shared:/root/shared"; fi
}

# the command tmux runs: oc-pane logs in to Debian and starts OpenCode via /root/.oc-start.sh
# (oc-pane keeps the window open and explains any crash itself, so nothing is repeated here)
start_cmd() { printf '%s' "oc-pane || exec bash"; }

# refuse to open a dead window: if something is missing, say exactly what, and stop
preflight() {
  local bad="" BIN="${PREFIX:-/data/data/com.termux/files/usr}/bin"
  [ -d "$ROOTFS/root" ] || bad="$bad
  - Debian is not installed yet."
  [ -x "$ROOTFS/root/.oc-start.sh" ] || bad="$bad
  - The OpenCode launcher is missing inside Debian."
  [ -x "$BIN/oc-pane" ] || bad="$bad
  - The oc-pane helper is missing in Termux."
  if [ ! -x "$ROOTFS/root/.opencode/bin/opencode" ] && [ ! -x "$ROOTFS/usr/local/bin/opencode" ] && [ ! -x "$ROOTFS/usr/bin/opencode" ]; then
    bad="$bad
  - OpenCode is not installed inside Debian."
  fi
  if [ -n "$bad" ]; then
    echo "OpenCode cannot start yet:$bad"
    echo
    echo "Run the installer (safe to repeat: it skips what is already done):"
    echo "  curl -fsSL https://raw.githubusercontent.com/$REPO/main/install.sh | bash"
    echo
    echo "Already installed and just wants a check?  oc doctor"
    return 1
  fi
}

wake_lock() {
  # keep the CPU awake while we work (shows a Termux notification; harmless if unavailable)
  if command -v termux-wake-lock >/dev/null 2>&1; then termux-wake-lock 2>/dev/null; fi
}

# ---- API keys -------------------------------------------------------------------------------
KEY_NAMES="gemini openrouter tavily firecrawl"
# sets VAR LABEL LINK MCP (MCP = the OpenCode MCP server this key switches on, or empty)
provider() {
  case "$1" in
    gemini|google) VAR=GOOGLE_GENERATIVE_AI_API_KEY; LABEL="Google Gemini"; LINK="https://aistudio.google.com/apikey"; MCP="" ;;
    openrouter)    VAR=OPENROUTER_API_KEY; LABEL="OpenRouter"; LINK="https://openrouter.ai/keys"; MCP="" ;;
    tavily)        VAR=TAVILY_API_KEY; LABEL="Tavily (research search)"; LINK="https://app.tavily.com/home"; MCP="tavily" ;;
    firecrawl)     VAR=FIRECRAWL_API_KEY; LABEL="Firecrawl (page scraping)"; LINK="https://www.firecrawl.dev/app/api-keys"; MCP="firecrawl" ;;
    *) return 1 ;;
  esac
}
key_is_set() { [ -f "$KEYFILE" ] && grep -q "^export $VAR=" "$KEYFILE"; }

# flip "enabled" for one MCP server block in the OpenCode config ($1 name, $2 true|false)
mcp_enabled() {
  [ -f "$CONF" ] || return 0
  local from=true to=false
  [ "$2" = true ] && { from=false; to=true; }
  sed -i "/\"$1\": {/,/\"enabled\"/ s/\"enabled\": $from/\"enabled\": $to/" "$CONF"
}

key_set() { # key_set name  (asks for the key; nothing shows as you type)
  provider "$1" || { echo "unknown provider '$1' (choose: $KEY_NAMES)"; return 1; }
  [ -d "$ROOTFS/root" ] || { echo "Debian is not installed yet: run the installer first."; return 1; }
  local val=""
  printf '\n%s key. Get one free at:\n  %s\nPaste it (nothing shows as you type) or press Enter to skip: ' "$LABEL" "$LINK" >/dev/tty
  read -rs val </dev/tty || val=""
  printf '\n' >/dev/tty
  if [ -z "$val" ]; then echo "skipped $LABEL"; return 0; fi
  case "$val" in *"'"*|*" "*|*'"'*) echo "that does not look like a key (it has a space or quote); nothing saved"; return 1 ;; esac
  if [ "${#val}" -lt 8 ]; then echo "that is too short to be a key; nothing saved"; return 1; fi
  ( umask 077; mkdir -p "$(dirname "$KEYFILE")"; touch "$KEYFILE"
    grep -v "^export $VAR=" "$KEYFILE" > "$KEYFILE.tmp" || true
    printf "export %s='%s'\n" "$VAR" "$val" >> "$KEYFILE.tmp"; mv "$KEYFILE.tmp" "$KEYFILE"; chmod 600 "$KEYFILE" )
  if [ -n "$MCP" ]; then mcp_enabled "$MCP" true; fi
  if [ "$MCP" = firecrawl ]; then
    # Firecrawl's server runs through npx, so Debian needs Node.js (installed only when this key is used)
    proot-distro login "$DISTRO" -- bash -c 'command -v npx >/dev/null 2>&1 || { apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs npm; }' \
      || echo "could not install Node.js for Firecrawl: run 'oc shell' then 'apt-get install nodejs npm'"
  fi
  echo "saved $LABEL key. Restart OpenCode to use it:  oc restart"
}

key_remove() {
  provider "${1:-}" || { echo "usage: oc key remove <${KEY_NAMES// /|}>"; return 1; }
  if [ -f "$KEYFILE" ]; then grep -v "^export $VAR=" "$KEYFILE" > "$KEYFILE.tmp" || true; mv "$KEYFILE.tmp" "$KEYFILE"; chmod 600 "$KEYFILE"; fi
  if [ -n "$MCP" ]; then mcp_enabled "$MCP" false; fi
  echo "removed $LABEL key"
}

key_list() {
  local n v
  for n in $KEY_NAMES; do
    provider "$n"
    if key_is_set; then v=$(grep "^export $VAR=" "$KEYFILE" | sed "s/.*='\(.*\)'.*/\1/"); printf '  %-10s set      (…%s)\n' "$n" "${v: -4}"
    else printf '  %-10s not set  %s\n' "$n" "$LINK"; fi
  done
}

# ---- oc model: choose which AI model OpenCode uses ------------------------------------------
# Model ids look like  provider/name . The free ones work with no key at all.
MODEL_CHOICES='opencode/deepseek-v4.1-flash-free|deepseek v4.1 flash|free - general use (the default)
opencode/glm-5.3-flash-free|glm 5.3 flash|free - quick answers
opencode/mimo-v2.6-flash-free|mimo v2.6 flash|free - long documents
opencode/nemotron-3.5-lightning-free|nemotron 3.5 lightning|free - fastest replies
opencode/beam-free|beam|free - small, simple jobs'
# the same list without the labels, in the order "auto" tries them
AUTO_MODELS="opencode/deepseek-v4.1-flash-free opencode/glm-5.3-flash-free opencode/mimo-v2.6-flash-free opencode/nemotron-3.5-lightning-free opencode/beam-free"

model_current() { sed -n 's/^[[:space:]]*"model":[[:space:]]*"\([^"]*\)".*/\1/p' "$CONF" 2>/dev/null | head -n1; }

# read one line from the keyboard; falls back to stdin when there is no terminal (tests, pipes)
ask_line() {
  if ( : </dev/tty ) 2>/dev/null; then read -r "$1" </dev/tty || printf -v "$1" '%s' ""; else read -r "$1" || printf -v "$1" '%s' ""; fi
}

# rewrite the "model" line in opencode.json (the kit owns that file, so the line always looks the same)
model_set() {
  local m=$1
  case "$m" in
    */*) ;;
    *) echo "a model looks like  provider/name  (for example: opencode/deepseek-v4.1-flash-free)"; return 1 ;;
  esac
  [ -f "$CONF" ] || { echo "the OpenCode config is missing: run the installer again"; return 1; }
  sed -i -E "0,/^[[:space:]]*\"model\":/s|^([[:space:]]*\"model\":[[:space:]]*\")[^\"]*\"|\1$m\"|" "$CONF"
  if [ "$(model_current)" = "$m" ]; then
    echo "model set to $m"
    echo "Restart OpenCode to use it:  oc restart"
  else
    echo "could not change the model automatically. The file is: $CONF"; return 1
  fi
}

# ask the free model to reply; used by "oc model auto" to find one that works right now
model_ping() { # model_ping MODEL
  timeout 60 proot-distro login "$DISTRO" -- bash -lc "export PATH=\"\$HOME/.opencode/bin:\$PATH\"; opencode run --model '$1' 'reply with the single word ok'" 2>&1 | grep -qiw ok
}

model_auto() {
  local m
  echo "Testing the free models (up to a minute each; stop with Ctrl-C)..."
  echo "Your current model: $(model_current)"
  for m in $AUTO_MODELS; do
    printf '  %-42s ' "$m"
    if model_ping "$m"; then echo "works"; model_set "$m" >/dev/null && { echo; echo "auto: using $m"; echo "Restart OpenCode:  oc restart"; return 0; }
    else echo "no answer"; fi
  done
  echo
  echo "none of them answered. That is usually the connection, not the model."
  echo "Try  oc doctor , or set one by hand:  oc model <provider/name>"
  return 1
}

model_list() {
  local out n
  echo "Models available on this phone (this takes a few seconds)..."
  out=$(timeout 90 proot-distro login "$DISTRO" -- bash -lc 'export PATH="$HOME/.opencode/bin:$PATH"; opencode models' 2>/dev/null) || out=""
  if [ -z "$out" ]; then
    echo "could not ask OpenCode for its list (it may need a restart first: oc restart)"
    return 1
  fi
  # free ones always work; others need the matching key (google -> Gemini, openrouter -> OpenRouter)
  printf '%s\n' "$out" | grep -E -- '-free$|:free$' | head -n 25 | sed 's/^/  /'
  n=$(printf '%s\n' "$out" | grep -Ec -- '-free$|:free$' || true)
  [ "${n:-0}" -gt 25 ] && echo "  ...and $((n - 25)) more free models"
  echo
  echo "Pick one with:  oc model provider/name     (or just run:  oc model)"
}

model_menu() {
  local i=0 name label note choice num current extra=""
  current=$(model_current)
  echo
  echo "  Current model: ${current:-not set}"
  echo
  echo "  Pick one (type the number, then Enter):"
  while IFS='|' read -r name label note; do
    [ -z "$name" ] && continue
    i=$((i + 1))
    printf '   %s  %-24s %s%s\n' "$i" "$label" "$note" "$([ "$name" = "$current" ] && echo '  <- now')"
  done <<EOF
$MODEL_CHOICES
EOF
  if [ -f "$KEYFILE" ] && grep -q '^export GOOGLE_GENERATIVE_AI_API_KEY=' "$KEYFILE"; then
    i=$((i + 1)); printf '   %s  %-24s %s\n' "$i" "gemini flash lite" "your Gemini key"
    extra="$extra google/gemini-flash-lite-latest"
  fi
  if [ -f "$KEYFILE" ] && grep -q '^export OPENROUTER_API_KEY=' "$KEYFILE"; then
    i=$((i + 1)); printf '   %s  %-24s %s\n' "$i" "OpenRouter free" "your OpenRouter key"
    extra="$extra openrouter/openrouter/free"
  fi
  printf '   a  %-24s %s\n' "auto" "test them and use the first that answers"
  printf '   l  %-24s %s\n' "list all" "every model this phone can use"
  printf '   0  %-24s %s\n' "cancel" ""
  { printf '\n  Choice: ' >/dev/tty; } 2>/dev/null || printf '\n  Choice: '
  ask_line choice
  { printf '\n' >/dev/tty; } 2>/dev/null || true
  case "$choice" in
    0|"") echo "nothing changed"; return 0 ;;
    a|A) model_auto ;;
    l|L) model_list ;;
    *[!0-9]*) echo "type a number, a, l or 0"; return 1 ;;
    *)  # map the number back to a model id
        num=$choice
        if [ "$num" -le 5 ]; then
          name=$(printf '%s\n' "$MODEL_CHOICES" | sed -n "${num}p" | cut -d'|' -f1)
        else
          name=$(printf '%s\n' $extra | sed -n "$((num - 5))p")
        fi
        [ -n "$name" ] || { echo "no choice $num"; return 1; }
        model_set "$name" ;;
  esac
}

# oc model           menu of models, with the current one shown
# oc model NAME      set one directly (provider/name)
# oc model auto      try the free models in turn and use the first that answers
# oc model list      every model this phone can use
cmd_model() {
  case "${1:-}" in
    "")     model_menu ;;
    list)   model_list ;;
    auto)   model_auto ;;
    *)      model_set "$1" ;;
  esac
}

# oc key            walk through every key you have not set yet (press Enter to skip each)
# oc key NAME       set or replace one key
# oc key list       show what is set (last 4 characters only)
# oc key remove N   delete one key
cmd_key() {
  case "${1:-}" in
    "")     local n; for n in $KEY_NAMES; do provider "$n"; if key_is_set; then echo "$LABEL: already set"; else key_set "$n"; fi; done ;;
    list)   key_list ;;
    remove) key_remove "${2:-}" ;;
    *)      key_set "$1" ;;
  esac
}

# oc autostart on   open OpenCode automatically whenever you open Termux
# oc autostart off  go back to a plain Termux prompt
BASHRC="$HOME/.bashrc"
MARK_A="# >>> opencode-kit autostart >>>"; MARK_B="# <<< opencode-kit autostart <<<"
autostart_off() { [ -f "$BASHRC" ] && sed -i "/^$MARK_A\$/,/^$MARK_B\$/d" "$BASHRC"; return 0; }
cmd_autostart() {
  case "${1:-}" in
    on)  autostart_off
         printf '%s\n%s\n%s\n' "$MARK_A" '[ -z "${TMUX:-}" ] && [ -z "${OC_NOAUTO:-}" ] && [ -t 0 ] && command -v oc >/dev/null 2>&1 && oc' "$MARK_B" >> "$BASHRC"
         echo "on: Termux will now open OpenCode by itself. Turn off with: oc autostart off" ;;
    off) autostart_off; echo "off: Termux opens a normal prompt again" ;;
    *)   if grep -qF "$MARK_A" "$BASHRC" 2>/dev/null; then echo "autostart is on (turn off: oc autostart off)"; else echo "autostart is off (turn on: oc autostart on)"; fi ;;
  esac
}

# ---- oc doctor: check everything and print a report you can screenshot --------------------------
cmd_doctor() {
  local bad=0 pf BIN="${PREFIX:-/data/data/com.termux/files/usr}/bin"
  say() { printf '  %-5s %s\n' "$1" "$2"; }
  good() { say "OK" "$1"; }
  fail() { say "FAIL" "$1"; bad=$((bad + 1)); }
  echo "OpenCode health check ($(date '+%H:%M'))"
  if command -v tmux >/dev/null 2>&1; then good "tmux $(tmux -V 2>/dev/null | cut -d' ' -f2)"; else fail "tmux is missing: run the installer again"; fi
  if command -v proot-distro >/dev/null 2>&1; then good "proot-distro $(proot-distro --version 2>/dev/null | head -n1)"; else fail "proot-distro is missing: run the installer again"; fi
  if [ -d "$ROOTFS/root" ]; then good "Debian found ($ROOTFS)"; else fail "Debian not found: run the installer again"; fi
  if [ -x "$ROOTFS/root/.oc-start.sh" ]; then good "launcher script present"; else fail "launcher script missing in Debian: run the installer again"; fi
  if [ -f "$CONF" ]; then good "OpenCode config present"; else fail "OpenCode config missing: run the installer again"; fi
  if [ -x "$ROOTFS/root/.opencode/bin/opencode" ]; then good "OpenCode installed"; else fail "OpenCode is not installed inside Debian: run the installer again"; fi
  if [ -x "$ROOTFS/root/.opencode/bin/opencode" ]; then
    local v; v=$(timeout 25 proot-distro login "$DISTRO" -- bash -lc 'export PATH="$HOME/.opencode/bin:$PATH"; opencode --version' 2>/dev/null | tail -n1)
    [ -n "$v" ] && say "info" "version: $v"
  fi
  if grep -qs 'opencode/bin' "$ROOTFS/root/.bashrc"; then good "opencode on the PATH in a plain Debian shell"; else say "WARN" "plain Debian shells need the full path to opencode: run the installer again to add it"; fi
  if [ -f "$HOME/.tmux.conf" ] && [ -f "$HOME/.tmux-menu.conf" ]; then good "tap menu installed"; else fail "tap menu files missing: run the installer again"; fi
  if [ -x "$BIN/oc-pane" ] && [ -x "$BIN/tmux-tap" ]; then good "window buttons helper installed"; else fail "oc-pane / tmux-tap missing: run the installer again"; fi
  if [ -d "$HOME/storage/shared" ]; then good "phone storage connected (reports go to the Research folder)"; else say "WARN" "phone storage not connected: run termux-setup-storage"; fi
  pf="${PREFIX:-/data/data/com.termux/files/usr}/etc/apt/sources.list"
  [ -f "$pf" ] && say "info" "download mirror: $(sed -n 's/^deb \([^ ]*\) .*/\1/p' "$pf" | head -n1 | sed 's#https://##')"
  if [ -f "$KEYFILE" ]; then say "info" "keys saved: $(grep -c '^export ' "$KEYFILE")"; else say "info" "no API keys saved (free models still work)"; fi
  if [ "$bad" -eq 0 ] && [ -x "$ROOTFS/root/.opencode/bin/opencode" ]; then
    echo "  ...asking the free model to say hi (takes up to a minute)"
    local out
    out=$(timeout 90 proot-distro login "$DISTRO" -- bash -lc 'export PATH="$HOME/.opencode/bin:$PATH"; opencode --version; opencode run "reply with the single word ok"' 2>&1 | tail -n 6) || true
    if printf '%s' "$out" | grep -qiw 'ok'; then good "OpenCode answered"; else fail "OpenCode did not answer. Last output:"; printf '%s\n' "$out" | sed 's/^/        /'; fi
  fi
  echo
  if [ "$bad" -eq 0 ]; then echo "All good. Start with:  oc"; else echo "$bad problem(s). Fix the FAIL lines above (usually: run the installer again). Screenshot this screen if you need help."; fi
  [ "$bad" -eq 0 ]
}

# already inside a tmux session: a second one nests, and the tap bar gets confusing
in_tmux() {
  if [ -n "${TMUX:-}" ]; then
    echo "You are already inside tmux (the ≡ MENU bar is at the top)."
    echo "Use this window, or leave with Ctrl-b then d and run  oc  in Termux."
    return 0
  fi
  return 1
}

cmd=${1:-start}
case "$cmd" in
  start)  in_tmux && exit 1
          preflight || exit 1
          wake_lock; exec tmux new-session -A -s "$SESSION" -n OpenCode "$(start_cmd)" ;;   # -A: attach if it exists, else create
  new)    in_tmux && exit 1
          preflight || exit 1
          wake_lock; exec tmux new-session -A -s "${2:?usage: oc new NAME}" -n OpenCode "$(start_cmd)" ;;
  restart) # end the session, then start it again (after oc key, oc update, or a fix)
          shift; n="${1:-$SESSION}"
          [ -n "${TMUX:-}" ] && { echo "Run  oc restart  in Termux, not inside the session it restarts."; exit 1; }
          if tmux has-session -t "=$n" 2>/dev/null; then tmux kill-session -t "=$n"; echo "restarted $n"; else echo "starting $n"; fi
          preflight || exit 1
          wake_lock; exec tmux new-session -A -s "$n" -n OpenCode "$(start_cmd)" ;;
  ls)     tmux ls 2>/dev/null || echo "no sessions running (start one with: oc)" ;;
  kill)   n="${2:-$SESSION}"
          if tmux has-session -t "=$n" 2>/dev/null; then tmux kill-session -t "=$n"; echo "ended session $n"
          else echo "no session called '$n' is running (see: oc ls)"; fi ;;
  key)    shift; cmd_key "$@" ;;
  model)  shift; cmd_model "$@" ;;
  autostart) shift; cmd_autostart "$@" ;;
  doctor) cmd_doctor ;;
  mirror) m="${PREFIX:-/data/data/com.termux/files/usr}/bin/oc-mirror"
          [ -f "$m" ] || { echo "the mirror tool is missing: run the installer again"; exit 1; }
          exec bash "$m" --update "${@:2}" ;;
  shell)  exec proot-distro login "$DISTRO" --shared-tmp $(bind_args) ;;
  update) proot-distro login "$DISTRO" -- bash -lc 'export PATH="$HOME/.opencode/bin:$PATH"; opencode upgrade || npm install -g opencode-ai@latest' || {
            echo "update failed; try again on a better connection"; exit 1; }
          echo; echo "updated. Restart OpenCode to use it:  oc restart" ;;
  help|-h|--help)
    cat <<'EOF'
oc               start OpenCode (or reattach if it is already running)
oc restart       restart the session (after adding a key or updating)
oc new NAME      start a second, separate session called NAME
oc ls            list running sessions
oc kill [N]      end a session (default: opencode)
oc key           add free API keys (Gemini, OpenRouter, Tavily, Firecrawl); Enter skips each
oc key NAME      add or replace one key (gemini | openrouter | tavily | firecrawl)
oc key list      show which keys are set
oc key remove N  delete a key
oc model         choose which AI model to use (free ones need no key)
oc model auto    test the free models and switch to the first that answers
oc model list    every model this phone can use
oc model NAME    use one directly, e.g. opencode/deepseek-v4.1-flash-free
oc mirror        re-test and switch to the fastest Termux download mirror
oc doctor        check that everything works and print a report (screenshot it for help)
oc autostart on  open OpenCode whenever Termux opens (off: back to a normal prompt)
oc shell         open a plain Debian shell
oc update        update OpenCode
Inside tmux: detach with Ctrl-b then d (OpenCode keeps running). Run oc again to come back.
EOF
    ;;
  *) echo "unknown command: $cmd (try: oc help)"; exit 1 ;;
esac
